{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "../PokeDexApp",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.git*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/assets/pokemon/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  }
}
